# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email Service (Gmail)
# Instructions: Enable 2FA → Generate App Password → Use here
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# SSLCommerz Payment Gateway (Optional)
# Get credentials from https://developer.sslcommerz.com/
SSLCOMMERZ_STORE_ID=your_store_id_here
SSLCOMMERZ_STORE_PASSWORD=your_store_password_here
SSLCOMMERZ_IS_LIVE=false

# URLs
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK
# Place serviceAccountKey.json file in server directory
# Download from Firebase Console → Project Settings → Service Accounts
